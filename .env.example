# Copie este arquivo para ".env" (na mesma pasta) e ajuste se precisar.
# O .env NUNCA vai para o Git: ele está no .gitignore.

# --- Banco de dados: escolha UMA das duas linhas DATABASE_URL -----------------

# Modo rápido (sem Docker): banco SQLite num arquivo local. Ideal para demonstrar.
DATABASE_URL=sqlite+aiosqlite:///./demo.db

# Modo completo (com Docker): PostgreSQL. Tire o # da linha abaixo e ponha # na de cima.
# DATABASE_URL=postgresql+asyncpg://achei:achei@localhost:5432/achei_encontrei

# Credenciais usadas pelo compose.yaml (mantenha iguais às da linha do PostgreSQL)
POSTGRES_USER=achei
POSTGRES_PASSWORD=achei
POSTGRES_DB=achei_encontrei

# --- Regras de prazo legal ------------------------------------------------------
PRAZO_LEGAL_DIAS=15
DIAS_ALERTA_PRAZO=10
